# ── LLM Backend ───────────────────────────────────────────────────────────────
# Choose: "gemini", "openai", or "ollama"
LLM_BACKEND=gemini

# ── Gemini (required when LLM_BACKEND=gemini) ────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBED_MODEL=text-embedding-004

# ── OpenAI (required when LLM_BACKEND=openai) ────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# ── Ollama (required when LLM_BACKEND=ollama) ────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text

# ── Storage ───────────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./data/chroma

# ── Retrieval ─────────────────────────────────────────────────────────────────
TOP_K_RETRIEVAL=5

# ── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# ── Auth (optional) ──────────────────────────────────────────────────────────
# If set, /query, /documents, /cases require: Authorization: Bearer <API_KEY>
# Leave blank to disable auth (local/dev only).
API_KEY=
